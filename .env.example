# Copy to .env (git-ignored) and fill in from Supabase → Project Settings → API.
# Only public values belong in the app bundle. NEVER add the service-role key,
# database password or JWT secret here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Where password-reset / email-confirmation links return to.
# Web defaults to <origin>/account; the native app uses its scheme.
EXPO_PUBLIC_AUTH_REDIRECT_URL=lavendermusic://account
