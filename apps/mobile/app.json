{
  "expo": {
    "name": "Lavender Music",
    "slug": "lavender-music",
    "version": "0.1.0",
    "scheme": "lavendermusic",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.lavender.music",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.lavender.music"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "phase": "06-audio-engine"
    }
  }
}
